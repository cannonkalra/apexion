# Apexion environment overrides. Copy to `.env` and edit as needed.
# Every setting in configs/apexion.yaml can be overridden with an APEXION_-
# prefixed variable (dots become underscores), e.g. APEXION_MINIO_ENDPOINT.

# --- Server -----------------------------------------------------------------
# APEXION_SERVER_HOST=0.0.0.0
# APEXION_SERVER_PORT=8080

# --- Object store (default connection) --------------------------------------
# APEXION_MINIO_ENDPOINT=localhost:9000
# APEXION_MINIO_ACCESS_KEY=minioadmin
# APEXION_MINIO_SECRET_KEY=minioadmin
# APEXION_MINIO_USE_SSL=false
# APEXION_MINIO_REGION=us-east-1

# --- Catalog storage --------------------------------------------------------
APEXION_STORAGE_PATH=./data/apexion.duckdb

# --- Logging ----------------------------------------------------------------
APEXION_LOG_PRETTY=true
# APEXION_LOG_LEVEL=info
