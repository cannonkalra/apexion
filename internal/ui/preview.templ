package ui

templ FilePreviewPage(vm PreviewVM) {
	@Layout("explorer", vm.Name) {
		<div class="flex flex-wrap items-start justify-between gap-4 mb-6">
			<div class="min-w-0">
				<div class="flex items-center gap-2">
					<h1 class="page-title truncate">{ vm.Name }</h1>
					@FormatPill(vm.Format)
					if vm.Compression != "none" && vm.Compression != "" {
						<span class="badge bg-base-700 text-slate-300">{ string(vm.Compression) }</span>
					}
				</div>
				<p class="muted mt-1 font-mono break-all">s3://{ vm.Bucket }/{ vm.Key }</p>
			</div>
			<div class="flex items-center gap-2 shrink-0">
				<a class="btn-ghost" href={ templ.SafeURL(parentExplorerURL(vm.Bucket, vm.Key)) }>← Back to folder</a>
				<a class="btn-ghost" href={ templ.SafeURL(sqlURLForFile(vm)) }>@iconTerminal() Query in SQL</a>
			</div>
		</div>

		<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
			@miniStat("Size", humanBytes(vm.Size))
			if vm.Result != nil {
				@miniStat("Columns", itoa(len(vm.Result.Columns)))
				@miniStat("Sample rows", itoa(vm.Result.RowCount))
				@miniStat("Query time", vm.Result.Elapsed)
			}
		</div>

		if len(vm.Partitions) > 0 {
			@partitionPanel(vm)
		}

		@Card() {
			<div class="card-header">
				<h2 class="section-title">DuckDB preview</h2>
				<p class="muted mt-1 font-mono">queried directly from object storage — no download</p>
			</div>
			@CardBody() {
				if vm.Error != "" {
					@ErrorBanner(vm.Error)
					if !vm.Ready {
						<p class="text-xs text-slate-500 mt-2">The DuckDB <span class="font-mono">httpfs</span> extension could not be loaded (needs network on first use). Preview will work once it is installed.</p>
					}
				} else if vm.Result != nil {
					@ResultTable(vm.Result)
				} else {
					@EmptyState("No preview available", "This file could not be previewed.")
				}
			}
		}
	}
}

// partitionPanel shows how the object's parent directories map to virtual Hive
// partition columns (pt0, pt1, …), with a copy button per value. The original
// physical path stays visible — nothing in storage is changed.
templ partitionPanel(vm PreviewVM) {
	<div class="mb-6">
		@Card() {
			@CardHeader("Partitions", "virtual — derived from the path, storage unchanged") {
			}
			@CardBody() {
				<div class="space-y-1.5 mb-3">
					for _, p := range vm.Partitions {
						<div class="flex items-center gap-3 text-sm min-w-0">
							<span class="font-mono text-brand-300 w-16 shrink-0">{ p.Name }</span>
							<span class="text-slate-600">=</span>
							<code class="font-mono text-slate-200 flex-1 min-w-0 truncate">{ p.Value }</code>
							<button class="btn-ghost !px-2 !py-1 text-xs shrink-0" data-copy={ p.Value } onclick="copyPartition(this)" title="Copy value">Copy</button>
						</div>
					}
				</div>
				<dl class="grid grid-cols-1 gap-1 text-xs border-t border-base-800 pt-3">
					@kvRow("Original path", vm.Bucket+"/"+vm.Key)
					@kvRow("Virtual path", vm.VirtualPath)
				</dl>
				<script>
					function copyPartition(el){ navigator.clipboard && navigator.clipboard.writeText(el.getAttribute('data-copy')); el.textContent='Copied'; setTimeout(function(){el.textContent='Copy';},1200); }
				</script>
			}
		}
	</div>
}

templ kvRow(label, value string) {
	<div class="flex items-start gap-3 min-w-0">
		<dt class="text-slate-500 w-24 shrink-0">{ label }</dt>
		<dd class="text-slate-300 font-mono min-w-0 break-all">{ value }</dd>
	</div>
}
