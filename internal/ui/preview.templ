package ui

import (
	"github.com/apexion/apexion/internal/duckdb"
	"github.com/apexion/apexion/internal/model"
)

templ FilePreviewPage(vm PreviewVM) {
	@Layout("explorer", "File preview") {
		<div class="flex flex-wrap items-start justify-between gap-4 mb-6">
			<div class="min-w-0">
				<div class="flex items-center gap-2">
					<h1 class="page-title truncate">{ vm.Name }</h1>
					@FormatPill(vm.Format)
					if vm.Compression != "none" && vm.Compression != "" {
						<span class="badge bg-base-700 text-slate-300">{ string(vm.Compression) }</span>
					}
				</div>
				<p class="muted mt-1 font-mono break-all">s3://{ vm.Bucket }/{ vm.Key }</p>
			</div>
			<div class="flex items-center gap-2 shrink-0">
				<a class="btn-ghost" href={ templ.SafeURL(parentExplorerURL(vm.Bucket, vm.Key)) }>← Back to folder</a>
				@QueryInSqlLink(vm.Bucket, vm.Key, vm.Format, vm.Opts, false)
			</div>
		</div>

		<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
			@miniStat("Size", humanBytes(vm.Size))
			if vm.Result != nil {
				@miniStat("Columns", itoa(len(vm.Result.Columns)))
				@miniStat("Sample rows", itoa(vm.Result.RowCount))
				@miniStat("Query time", vm.Result.Elapsed)
			}
		</div>

		if len(vm.Partitions) > 0 {
			@partitionPanel(vm)
		}

		@Card() {
			<div class="card-header">
				<h2 class="section-title">DuckDB preview</h2>
				<p class="muted mt-1 font-mono">queried directly from object storage — no download</p>
			</div>
			@CardBody() {
				@ReaderOptionsBar(filePreviewOptsVM(vm))
				<div id="file-preview-result">
					if vm.Error != "" {
						@ErrorBanner(vm.Error)
						if !vm.Ready {
							<p class="text-xs text-slate-500 mt-2">The DuckDB <span class="font-mono">httpfs</span> extension could not be loaded (needs network on first use). Preview will work once it is installed.</p>
						}
					} else if vm.Result != nil {
						@PreviewResultWith(vm.Result, insightsHref(vm.Bucket, vm.Key, vm.Format, vm.Opts))
					} else {
						@EmptyState("No preview available", "This file could not be previewed.")
					}
				</div>
			}
		}
	}
}

// PreviewOptions is the live reader-options bar shown above a data preview. Any
// change re-GETs the preview endpoint with the toggles and swaps the result in
// place — so the generated SQL and the sample rows update instantly. It renders
// only the options the format actually honours (nothing for Iceberg/Delta).
templ PreviewOptions(vm PreviewOptsVM) {
	if hasPreviewOpts(vm.Format) {
		<form
			hx-get={ vm.Endpoint }
			hx-target={ "#" + vm.Target }
			hx-swap="innerHTML"
			hx-trigger="change"
			class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-4 pb-4 border-b border-base-800 text-sm"
		>
			<input type="hidden" name="applied" value="1"/>
			for _, kv := range vm.Hidden {
				<input type="hidden" name={ kv[0] } value={ kv[1] }/>
			}
			<span class="eyebrow">Reader options</span>
			if optHeader(vm.Format) {
				<label class="flex items-center gap-2 text-slate-300">Header
					<select name="header" class="select !w-auto !py-1">
						@optionSel("auto", "Auto", vm.Opts.Header)
						@optionSel("present", "On", vm.Opts.Header)
						@optionSel("none", "Off", vm.Opts.Header)
					</select>
				</label>
			}
			if optUnion(vm.Format) {
				@optCheckbox("union_by_name", "Union by name", vm.Opts.UnionByName)
			}
			if optIgnore(vm.Format) {
				@optCheckbox("ignore_errors", "Ignore errors", vm.Opts.IgnoreErrors)
			}
		</form>
	}
}

// ReaderOptionsBar is the always-visible reader-options bar for single-file
// surfaces (the preview page and the SQL editor). Unlike PreviewOptions it
// leads with a "Read as" format selector, so an undetected or misnamed file
// (e.g. a gzipped .log that is really JSON Lines) can be pointed at the right
// reader; and it shows every toggle regardless of the current format, since
// changing the format changes which toggles apply. The server emits only the
// options each reader honours, so a toggle the format ignores is harmless.
templ ReaderOptionsBar(vm PreviewOptsVM) {
	<form
		if vm.Method == "post" {
			hx-post={ vm.Endpoint }
		} else {
			hx-get={ vm.Endpoint }
		}
		hx-target={ "#" + vm.Target }
		hx-swap={ swapOr(vm.Swap) }
		hx-trigger="change"
		class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-4 pb-4 border-b border-base-800 text-sm"
	>
		<input type="hidden" name="applied" value="1"/>
		for _, kv := range vm.Hidden {
			<input type="hidden" name={ kv[0] } value={ kv[1] }/>
		}
		<span class="eyebrow">Reader options</span>
		if vm.ShowFormat {
			<label class="flex items-center gap-2 text-slate-300">Read as
				<select name="format" class="select !w-auto !py-1">
					@optionSel("", "— pick format —", readAsCurrent(vm.Format))
					@optionSel("csv", "CSV", readAsCurrent(vm.Format))
					@optionSel("tsv", "TSV", readAsCurrent(vm.Format))
					@optionSel("json", "JSON", readAsCurrent(vm.Format))
					@optionSel("jsonl", "JSON Lines (NDJSON)", readAsCurrent(vm.Format))
					@optionSel("parquet", "Parquet", readAsCurrent(vm.Format))
				</select>
			</label>
		}
		<label class="flex items-center gap-2 text-slate-300">Header
			<select name="header" class="select !w-auto !py-1">
				@optionSel("auto", "Auto", vm.Opts.Header)
				@optionSel("present", "On", vm.Opts.Header)
				@optionSel("none", "Off", vm.Opts.Header)
			</select>
		</label>
		@optCheckbox("union_by_name", "Union by name", vm.Opts.UnionByName)
		@optCheckbox("ignore_errors", "Ignore errors", vm.Opts.IgnoreErrors)
	</form>
}

// QueryInSqlLink is the "Query in SQL" button on the file-preview header. It
// carries the file's identity + current reader options to the SQL editor. When
// the format has no DuckDB reader (undetected/Avro/ORC) it renders disabled so
// the user isn't sent to an editor that cannot query the file. With oob=true it
// is swapped out-of-band by the preview options bar, so choosing a format /
// toggling "Ignore errors" on the preview flows straight into the editor link.
templ QueryInSqlLink(bucket, key string, format model.Format, opts model.ReadOptions, oob bool) {
	if href, ok := fileQueryURL(bucket, key, format, opts); ok {
		<a
			id="query-in-sql-link"
			if oob {
				hx-swap-oob="true"
			}
			class="btn-ghost"
			href={ templ.SafeURL(href) }
		>@iconTerminal() Query in SQL</a>
	} else {
		<span
			id="query-in-sql-link"
			if oob {
				hx-swap-oob="true"
			}
			class="btn-ghost opacity-40 cursor-not-allowed"
			title="Choose a readable format above to query this file in SQL"
		>@iconTerminal() Query in SQL</span>
	}
}

// filePreviewFragment is the HTMX response for a preview options change: the
// refreshed result table plus an out-of-band update of the Query-in-SQL link so
// it reflects the just-chosen format and reader options.
templ filePreviewFragment(res *duckdb.Result, insightsURL, bucket, key string, format model.Format, opts model.ReadOptions) {
	@PreviewResultWith(res, insightsURL)
	@QueryInSqlLink(bucket, key, format, opts, true)
}

// filePreviewErrorFragment is filePreviewFragment for a failed preview: the
// error message plus the same out-of-band link update.
templ filePreviewErrorFragment(msg, bucket, key string, format model.Format, opts model.ReadOptions) {
	@ErrorBanner(msg)
	@QueryInSqlLink(bucket, key, format, opts, true)
}

// PreviewResult shows the exact generated SQL (Result.SQL) above the sample rows,
// so the preview surfaces double as a live SQL builder. Insights are off — used
// by the dataset preview tab and any caller that opts out.
templ PreviewResult(res *duckdb.Result) {
	@PreviewResultWith(res, "")
}

// PreviewResultWith is PreviewResult plus lazy-loaded column insights when
// insightsURL is non-empty (the single-file preview surface).
templ PreviewResultWith(res *duckdb.Result, insightsURL string) {
	if res.SQL != "" {
		<div class="mb-3">
			<div class="eyebrow mb-1">Generated SQL</div>
			<pre class="text-xs font-mono text-slate-400 bg-base-950/50 border border-base-800 rounded-lg px-3 py-2 overflow-x-auto whitespace-pre-wrap break-all">{ res.SQL }</pre>
		</div>
	}
	@ResultTableWith(res, insightsURL)
}

// partitionPanel shows how the object's parent directories map to virtual Hive
// partition columns (pt0, pt1, …), with a copy button per value. The original
// physical path stays visible — nothing in storage is changed.
templ partitionPanel(vm PreviewVM) {
	<div class="mb-6">
		@Card() {
			@CardHeader("Partitions", "virtual — derived from the path, storage unchanged") {
			}
			@CardBody() {
				<div class="space-y-1.5 mb-3">
					for _, p := range vm.Partitions {
						<div class="flex items-center gap-3 text-sm min-w-0">
							<span class="font-mono text-brand-300 w-16 shrink-0">{ p.Name }</span>
							<span class="text-slate-600">=</span>
							<code class="font-mono text-slate-200 flex-1 min-w-0 truncate">{ p.Value }</code>
							<button class="btn-ghost !px-2 !py-1 text-xs shrink-0" data-copy={ p.Value } onclick="copyPartition(this)" title="Copy value">Copy</button>
						</div>
					}
				</div>
				<dl class="grid grid-cols-1 gap-1 text-xs border-t border-base-800 pt-3">
					@kvRow("Original path", vm.Bucket+"/"+vm.Key)
					@kvRow("Virtual path", vm.VirtualPath)
				</dl>
				<script>
					function copyPartition(el){ navigator.clipboard && navigator.clipboard.writeText(el.getAttribute('data-copy')); el.textContent='Copied'; setTimeout(function(){el.textContent='Copy';},1200); }
				</script>
			}
		}
	</div>
}

templ kvRow(label, value string) {
	<div class="flex items-start gap-3 min-w-0">
		<dt class="text-slate-500 w-24 shrink-0">{ label }</dt>
		<dd class="text-slate-300 font-mono min-w-0 break-all">{ value }</dd>
	</div>
}
