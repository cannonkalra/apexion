package ui

import "fmt"

var wizardStepNames = []string{"Source", "Analyze", "Review", "Register", "Done"}

// WizardPage is the full-page Crawl → Analyze → Review → Register wizard.
templ WizardPage(vm WizardVM) {
	@Layout("wizard", "Crawl Dataset") {
		<div style="max-width:60rem;margin-left:auto;margin-right:auto">
			<div id="wizard-body">
				@WizardStep1(vm)
			</div>
		</div>
	}
}

templ wizardStepper(active int) {
	<div class="flex items-center gap-2 mb-6">
		for i, name := range wizardStepNames {
			<div class={ "flex items-center gap-2", templ.KV("text-white", i == active), templ.KV("text-slate-500", i != active) }>
				<span class={ "grid place-items-center w-6 h-6 rounded-full text-xs font-semibold", templ.KV("bg-brand-600 text-white", i <= active), templ.KV("bg-base-800 text-slate-500", i > active) }>{ fmt.Sprintf("%d", i+1) }</span>
				<span class="text-sm hidden sm:block">{ name }</span>
			</div>
			if i < len(wizardStepNames)-1 {
				<div class="flex-1 h-px bg-base-800"></div>
			}
		}
	</div>
}

// ---- Step 1: Source ------------------------------------------------------
templ WizardStep1(vm WizardVM) {
	@wizardStepper(0)
	<div class="card p-6">
		<h2 class="text-lg font-semibold text-white mb-1">Select source</h2>
		<p class="text-sm text-slate-500 mb-5">Choose the storage directory to crawl into a dataset.</p>
		if vm.Error != "" {
			<div class="mb-4 rounded-lg border border-accent-rose/40 bg-accent-rose/5 p-3 text-sm text-accent-rose font-mono">{ vm.Error }</div>
		}
		<form hx-post="/ui/wizard/crawl" hx-target="#wizard-body" hx-swap="innerHTML" class="space-y-4">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				<div>
					<label class="block text-xs uppercase tracking-wider text-slate-500 mb-1">Bucket</label>
					<input name="bucket" value={ vm.Bucket } placeholder="bucket" class={ inputClass }/>
				</div>
				<div>
					<label class="block text-xs uppercase tracking-wider text-slate-500 mb-1">Directory (prefix)</label>
					<input name="prefix" value={ vm.Prefix } placeholder="path/to/dir/" class={ inputClass }/>
				</div>
				<div>
					<label class="block text-xs uppercase tracking-wider text-slate-500 mb-1">Glob pattern</label>
					<input name="glob" placeholder="**/*  (auto)" class={ inputClass }/>
				</div>
				<div>
					<label class="block text-xs uppercase tracking-wider text-slate-500 mb-1">Ignore patterns</label>
					<input name="ignore" placeholder="_tmp/, .checkpoint" class={ inputClass }/>
				</div>
			</div>
			<div class="flex items-center gap-4 text-sm text-slate-300">
				<label class="flex items-center gap-2"><input type="checkbox" name="recursive" checked class="rounded bg-base-950 border-base-700"/> Recursive</label>
				<label class="flex items-center gap-2"><input type="checkbox" name="include_hidden" class="rounded bg-base-950 border-base-700"/> Include hidden</label>
			</div>
			<div class="flex items-center justify-end gap-2 pt-2">
				<a class="btn-ghost" href="/explorer">Cancel</a>
				<button class="btn-primary" type="submit">Next @iconPlay()</button>
			</div>
		</form>
	</div>
}

// ---- Step 2: Analyze (streaming progress) --------------------------------
templ WizardStep2Progress(vm WizardVM) {
	<div
		hx-get={ wizardProgressURL(vm) }
		hx-trigger="load delay:1200ms"
		hx-target="#wizard-body"
		hx-swap="innerHTML"
	>
		@wizardStepper(1)
		<div class="card p-6">
			<h2 class="text-lg font-semibold text-white mb-1">Analyzing</h2>
			<p class="text-sm text-slate-500 mb-5">Crawling { vm.Bucket }/{ vm.Prefix } — discovering files, schema and partitions.</p>
			if vm.Job != nil {
				@ProgressBar(vm.Job.Progress)
				<div class="mt-3 text-sm text-slate-400">{ wizardJobMessage(vm.Job) }</div>
			} else {
				@ProgressBar(0.02)
				<div class="mt-3 text-sm text-slate-400">Starting…</div>
			}
			<div class="mt-4 text-xs text-slate-600">This runs in the background — progress updates automatically.</div>
		</div>
	</div>
}

// ---- Step 3: Review ------------------------------------------------------
templ WizardStep3(vm WizardVM) {
	@wizardStepper(2)
	<div class="card p-6">
		<h2 class="text-lg font-semibold text-white mb-1">Review dataset</h2>
		<p class="text-sm text-slate-500 mb-5">Discovered metadata for { vm.Detail.Dataset.Name }.</p>
		<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
			@miniStat("Format", string(vm.Detail.Dataset.Format))
			@miniStat("Files", fmt.Sprintf("%d", vm.Detail.Dataset.FileCount))
			@miniStat("Size", humanBytes(vm.Detail.Dataset.TotalSize))
			@miniStat("Est. rows", humanCount(vm.Detail.Dataset.RowCount))
			@miniStat("Columns", fmt.Sprintf("%d", columnCount(vm.Detail)))
			@miniStat("Partitions", fmt.Sprintf("%d", len(vm.Detail.Partitions)))
			@miniStat("Compression", string(vm.Detail.Dataset.Compression))
			@miniStat("Location", vm.Detail.Dataset.BucketName+"/"+vm.Detail.Dataset.Path)
		</div>
		<details class="mb-4" open>
			<summary class="text-sm text-slate-300 cursor-pointer mb-2">Detected schema</summary>
			if vm.Detail.Schema == nil || len(vm.Detail.Schema.Columns) == 0 {
				<p class="text-sm text-slate-500">No schema inferred.</p>
			} else {
				@schemaTable(vm.Detail.Schema)
			}
		</details>
		<div class="flex items-center justify-end gap-2 pt-2">
			<form hx-post="/ui/wizard/skip" hx-target="#wizard-body" hx-swap="innerHTML">
				<input type="hidden" name="dataset_id" value={ vm.Detail.Dataset.ID }/>
				<button class="btn-ghost" type="submit">Skip registration</button>
			</form>
			<form hx-post="/ui/wizard/register-form" hx-target="#wizard-body" hx-swap="innerHTML">
				<input type="hidden" name="dataset_id" value={ vm.Detail.Dataset.ID }/>
				<button class="btn-primary" type="submit">@iconTable() Register as table</button>
			</form>
		</div>
	</div>
}

// ---- Step 4: Register ----------------------------------------------------
templ WizardStep4(vm WizardVM) {
	@wizardStepper(3)
	<div class="card p-6">
		<h2 class="text-lg font-semibold text-white mb-1">Register as SQL table</h2>
		<p class="text-sm text-slate-500 mb-5">Exposes { vm.Detail.Dataset.Name } as a DuckDB view — no data is copied.</p>
		if vm.Error != "" {
			<div class="mb-4 rounded-lg border border-accent-rose/40 bg-accent-rose/5 p-3 text-sm text-accent-rose font-mono">{ vm.Error }</div>
		}
		<form hx-post="/ui/wizard/register" hx-target="#wizard-body" hx-swap="innerHTML" class="space-y-4">
			<input type="hidden" name="dataset_id" value={ vm.Detail.Dataset.ID }/>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				<div>
					<label class="block text-xs uppercase tracking-wider text-slate-500 mb-1">Table name</label>
					<input name="name" value={ vm.Suggested } required pattern="[A-Za-z_][A-Za-z0-9_]*" class={ inputClass + " font-mono" }/>
					<p class="text-[11px] text-slate-600 mt-1">Letters, digits, underscore — must not start with a digit.</p>
				</div>
				<div>
					<label class="block text-xs uppercase tracking-wider text-slate-500 mb-1">Schema strategy</label>
					<select name="schema_strategy" class={ inputClass }>
						<option value="union">Union — merge compatible files (default)</option>
						<option value="strict">Strict — require identical schemas</option>
						<option value="latest">Latest — use the newest file's schema</option>
					</select>
				</div>
			</div>
			<div>
				<label class="block text-xs uppercase tracking-wider text-slate-500 mb-1">Description (optional)</label>
				<input name="description" placeholder="What this table contains" class={ inputClass }/>
			</div>
			<div class="rounded-lg border border-base-800 p-4 space-y-3">
				<div class="text-xs uppercase tracking-wider text-slate-500">Read options</div>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm text-slate-300">
					<label class="flex items-center gap-2"><input type="checkbox" name="opt_filename" checked class="rounded bg-base-950 border-base-700"/> Add filename column</label>
					<label class="flex items-center gap-2"><input type="checkbox" name="opt_union" checked class="rounded bg-base-950 border-base-700"/> Union by column name</label>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
					<div>
						<label class="block text-xs uppercase tracking-wider text-slate-500 mb-1">Header (CSV)</label>
						<select name="opt_header" class={ inputClass }>
							<option value="auto">Auto-detect (default)</option>
							<option value="present">Has header row</option>
							<option value="none">No header row</option>
						</select>
					</div>
					<div>
						<label class="block text-xs uppercase tracking-wider text-slate-500 mb-1">Sample size (CSV)</label>
						<input name="opt_sample_size" placeholder="1000" pattern="-?[0-9]+" class={ inputClass + " font-mono" }/>
						<p class="text-[11px] text-slate-600 mt-1">Rows scanned for type inference. Empty = default; -1 = scan all.</p>
					</div>
				</div>
				<label class="flex items-center gap-2 text-sm text-slate-300"><input type="checkbox" name="opt_ignore_errors" class="rounded bg-base-950 border-base-700"/> Ignore malformed rows</label>
			</div>
			<div class="flex items-center justify-end gap-2 pt-2">
				<button
					type="button"
					class="btn-ghost"
					hx-post="/ui/wizard/skip"
					hx-vals={ wizardSkipVals(vm.Detail.Dataset.ID) }
					hx-target="#wizard-body"
					hx-swap="innerHTML"
				>Skip</button>
				<button class="btn-primary" type="submit">@iconTable() Register</button>
			</div>
		</form>
	</div>
}

// ---- Step 5: Finish ------------------------------------------------------
templ WizardStep5(vm WizardVM) {
	@wizardStepper(4)
	<div class="card p-6 text-center">
		<div class="grid place-items-center w-12 h-12 rounded-full bg-accent-emerald/15 text-accent-emerald mx-auto mb-4">@iconEye()</div>
		<h2 class="text-lg font-semibold text-white mb-1">Done</h2>
		<div class="text-sm text-slate-400 space-y-1 mb-6">
			<div>✓ Dataset created</div>
			if vm.Entry != nil {
				<div>✓ Catalog entry created — <span class="font-mono text-slate-200">{ vm.Entry.Name }</span></div>
				<div>✓ DuckDB view created</div>
			} else {
				<div class="text-slate-500">Dataset was not registered as a table.</div>
			}
		</div>
		<div class="flex items-center justify-center gap-2 flex-wrap">
			if vm.Detail != nil {
				<a class="btn-ghost" href={ templ.SafeURL("/datasets/" + vm.Detail.Dataset.ID) }>Open dataset</a>
			}
			if vm.Entry != nil {
				<a class="btn-ghost" href="/catalog">Open catalog</a>
				<a class="btn-primary" href={ templ.SafeURL("/query?table=" + vm.Entry.Name) }>@iconTerminal() Query table</a>
			}
			<a class="btn-ghost" href="/datasets">Done</a>
		</div>
	</div>
}

templ WizardError(msg string) {
	<div class="card p-6">
		<div class="text-sm text-accent-rose mb-4">{ msg }</div>
		<a class="btn-ghost" href="/wizard">Start over</a>
		<a class="btn-ghost" href="/datasets">Go to datasets</a>
	</div>
}
