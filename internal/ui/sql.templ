package ui

import "github.com/apexion/apexion/internal/preview"

templ SQLPage(vm SQLVM) {
	@Layout("sql", "SQL Scratchpad") {
		<div class="mb-4">
			<h1 class="text-lg font-semibold text-white">SQL Scratchpad</h1>
			<p class="text-sm text-slate-500">Run read-only DuckDB queries directly against object storage. Only SELECT, WITH, DESCRIBE, SUMMARIZE, SHOW and EXPLAIN are permitted.</p>
			if vm.DatasetName != "" {
				<p class="text-xs text-slate-500 mt-1">Context: <span class="text-slate-300 font-mono">{ vm.DatasetName }</span></p>
			}
		</div>

		if !vm.Ready {
			<div class="card border-accent-amber/40 bg-accent-amber/5 p-4 mb-4 text-sm text-slate-300">
				DuckDB S3 access is not available: <span class="font-mono text-xs">{ truncate(vm.SetupError, 160) }</span>
			</div>
		}

		<form hx-post="/ui/sql" hx-target="#sql-results" hx-swap="innerHTML" hx-indicator="#sql-spin" class="card p-4 mb-4">
			<textarea
				name="sql"
				rows="6"
				spellcheck="false"
				class="w-full bg-base-950 border border-base-800 rounded-lg p-3 font-mono text-sm text-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500/40 resize-y"
				placeholder="SELECT * FROM read_parquet('s3://bucket/path/*.parquet') LIMIT 100"
			>{ vm.InitialSQL }</textarea>
			<div class="flex items-center justify-between mt-3">
				<div class="flex items-center gap-2 text-xs text-slate-500">
					<label>Limit</label>
					<input name="limit" type="number" value="200" min="1" max="1000" class="w-20 bg-base-950 border border-base-800 rounded px-2 py-1 text-slate-200"/>
					<span id="sql-spin" class="htmx-indicator text-brand-300">running…</span>
				</div>
				<button class="btn-primary" type="submit">@iconPlay() Run query</button>
			</div>
		</form>

		<div id="sql-results">
			<div class="card p-8 text-center text-sm text-slate-500">Results will appear here.</div>
		</div>
	}
}

// SQLResult renders scratchpad output (HTMX target).
templ SQLResult(res *preview.Result, errMsg string) {
	if errMsg != "" {
		@QueryError(errMsg)
	} else if res != nil {
		<div class="card p-4">
			@ResultTable(res)
		</div>
	}
}
