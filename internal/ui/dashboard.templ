package ui

import (
	"fmt"
	"github.com/apexion/apexion/internal/model"
	"github.com/apexion/apexion/internal/storage"
)

// DashboardVM is the dashboard view model.
type DashboardVM struct {
	Stats   *storage.DashboardStats
	Formats map[string]int64
	Jobs    []model.Job
	Runs    []model.CrawlerRun
	Events  []model.Event
}

templ DashboardPage(vm DashboardVM) {
	@Layout("dashboard", "Dashboard") {
		<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
			@StatCard("Buckets", humanCount(vm.Stats.Buckets), "object stores", "bg-brand-500/15 text-brand-300", iconBucket())
			@StatCard("Datasets", humanCount(vm.Stats.Datasets), "discovered", "bg-accent-emerald/15 text-accent-emerald", iconTable())
			@StatCard("Objects", humanCount(vm.Stats.Objects), humanBytes(vm.Stats.TotalSize), "bg-accent-amber/15 text-accent-amber", iconDatabase())
			@StatCard("Columns", humanCount(vm.Stats.Columns), fmt.Sprintf("%s tables", humanCount(vm.Stats.Tables)), "bg-accent-violet/15 text-accent-violet", iconColumns())
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mt-4">
			<div class="lg:col-span-2 card p-5">
				@SectionHeader("Format distribution", "datasets by storage format") {
				}
				@formatChart(vm.Formats)
			</div>
			<div class="card p-5">
				<div class="flex items-center justify-between mb-4">
					<h2 class="text-base font-semibold text-white">Running jobs</h2>
					<span class="badge bg-brand-500/15 text-brand-300">{ fmt.Sprintf("%d active", vm.Stats.RunningJobs) }</span>
				</div>
				<div id="dashboard-jobs" hx-get="/ui/partials/jobs" hx-trigger="load, every 3s" hx-swap="innerHTML">
					@JobsList(vm.Jobs)
				</div>
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mt-4">
			<div class="lg:col-span-2 card p-5">
				@SectionHeader("Recent crawler runs", "latest discovery activity") {
					<a href="/runs" class="btn-ghost text-xs">View all</a>
				}
				@runsTable(vm.Runs, true)
			</div>
			<div class="card p-5">
				<h2 class="text-base font-semibold text-white mb-4">Activity feed</h2>
				<div id="activity-feed" hx-get="/ui/partials/activity" hx-trigger="load, every 5s" hx-swap="innerHTML">
					@ActivityFeed(vm.Events)
				</div>
			</div>
		</div>
	}
}

templ formatChart(formats map[string]int64) {
	if len(formats) == 0 {
		<p class="text-sm text-slate-500">No datasets yet. Crawl a bucket to populate the catalog.</p>
	} else {
		<div class="space-y-3">
			for _, row := range formatRows(formats) {
				<div>
					<div class="flex items-center justify-between text-sm mb-1">
						<span class="text-slate-300 font-medium">{ row.Label }</span>
						<span class="text-slate-500">{ fmt.Sprintf("%d", row.Count) }</span>
					</div>
					<div class="w-full h-2 rounded-full bg-base-800 overflow-hidden">
						<div class={ "h-full rounded-full", row.Color } style={ fmt.Sprintf("width:%.1f%%", row.Pct) }></div>
					</div>
				</div>
			}
		</div>
	}
}

templ ActivityFeed(events []model.Event) {
	if len(events) == 0 {
		<p class="text-sm text-slate-500">No events yet.</p>
	} else {
		<ul class="space-y-3">
			for _, e := range events {
				<li class="flex items-start gap-3">
					<span class={ "mt-1.5 w-2 h-2 rounded-full shrink-0", eventDot(e.Type) }></span>
					<div class="min-w-0">
						<div class="text-sm text-slate-200">{ eventLabel(e.Type) }</div>
						<div class="text-xs text-slate-500">{ timeAgo(e.CreatedAt) }</div>
					</div>
				</li>
			}
		</ul>
	}
}
