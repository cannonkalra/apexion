package ui

import (
	"fmt"
	"github.com/apexion/apexion/internal/model"
)

templ DatasetsPage(vm DatasetsVM) {
	@Layout("datasets", "Datasets") {
		@PageHeader("", fmt.Sprintf("%d datasets", len(vm.Datasets))) {
			<a class="btn-primary" href="/wizard">@iconInbox() Crawl Dataset</a>
		}

		<div class="space-y-6">
			<form method="get" class="card p-4 flex flex-wrap items-end gap-4">
				<div>
					<label class="form-label">Search</label>
					<input name="q" value={ vm.Filter.Search } placeholder="name or path…" class="input"/>
				</div>
				<div>
					<label class="form-label">Bucket</label>
					<select name="bucket_id" class="select">
						<option value="">All buckets</option>
						for _, b := range vm.Buckets {
							if b.ID == vm.Filter.BucketID {
								<option value={ b.ID } selected>{ b.Name }</option>
							} else {
								<option value={ b.ID }>{ b.Name }</option>
							}
						}
					</select>
				</div>
				<div>
					<label class="form-label">Format</label>
					<select name="format" class="select">
						<option value="">All formats</option>
						for _, f := range allFormats {
							if string(f) == vm.Filter.Format {
								<option value={ string(f) } selected>{ string(f) }</option>
							} else {
								<option value={ string(f) }>{ string(f) }</option>
							}
						}
					</select>
				</div>
				<button class="btn-primary" type="submit">Filter</button>
			</form>

			<div class="card overflow-hidden">
				if len(vm.Datasets) == 0 {
					@EmptyState("No datasets yet", "Use “Crawl Dataset” to discover a directory as a dataset.")
				} else {
					<div class="overflow-x-auto">
						<table class="w-full">
						<thead>
							<tr class="border-b border-base-800">
								<th class="th">Dataset</th>
								<th class="th">Format</th>
								<th class="th">Rows</th>
								<th class="th">Files</th>
								<th class="th">Size</th>
								<th class="th">Partitions</th>
								<th class="th">Catalog</th>
								<th class="th">Last Scan</th>
								<th class="th text-right">Actions</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-base-800">
							for _, d := range vm.Datasets {
								@datasetRow(d, vm.Registered[d.ID])
							}
						</tbody>
					</table>
				</div>
			}
			</div>
		</div>
		<div id="toast-slot"></div>
	}
}

templ datasetRow(d model.Dataset, catalogCount int) {
	<tr id={ "dataset-" + d.ID } class="hover:bg-base-850/50">
		<td class="table-cell">
			<a href={ templ.SafeURL("/datasets/" + d.ID) } class="font-medium text-slate-100 hover:text-brand-300">{ d.Name }</a>
			<div class="text-xs text-slate-500 break-all max-w-xs">{ truncate(d.BucketName+"/"+d.Path, 48) }</div>
		</td>
		<td class="table-cell">@FormatPill(d.Format)</td>
		<td class="table-cell text-slate-300">{ humanCount(d.RowCount) }</td>
		<td class="table-cell text-slate-300">{ fmt.Sprintf("%d", d.FileCount) }</td>
		<td class="table-cell text-slate-400">{ humanBytes(d.TotalSize) }</td>
		<td class="table-cell text-slate-400 font-mono text-xs">{ partitionKeyList(d.PartitionKeys) }</td>
		<td class="table-cell">
			if catalogCount > 0 {
				<a href="/catalog" class="badge bg-accent-emerald/15 text-accent-emerald">Registered
					if catalogCount > 1 {
						({ fmt.Sprintf("%d", catalogCount) })
					}
				</a>
			} else {
				<span class="badge bg-base-700 text-slate-400">Not registered</span>
			}
		</td>
		<td class="table-cell text-slate-500">{ timeAgoPtr(d.LastScanAt) }</td>
		<td class="table-cell">
			<div class="flex items-center justify-end gap-1">
				<a href={ templ.SafeURL("/datasets/" + d.ID) } class="btn-ghost !px-2 !py-1" title="Open">@iconEye()</a>
				if catalogCount == 0 {
					<button class="btn-ghost !px-2 !py-1" title="Register as table" hx-post={ "/ui/datasets/" + d.ID + "/register" } hx-target="#toast-slot" hx-swap="innerHTML">@iconTable()</button>
				}
				<button class="btn-ghost !px-2 !py-1" title="Refresh (re-crawl)" hx-post={ "/ui/datasets/" + d.ID + "/refresh" } hx-target="#toast-slot" hx-swap="innerHTML">@iconRefresh()</button>
				<button
					class="btn-danger !px-2 !py-1"
					title="Delete"
					hx-delete={ "/ui/datasets/" + d.ID }
					hx-confirm="Delete this dataset?"
					hx-target={ "#dataset-" + d.ID }
					hx-swap="outerHTML swap:200ms"
				>@iconTrash()</button>
			</div>
		</td>
	</tr>
}
