package ui

import "github.com/apexion/apexion/internal/model"

templ SchemaPage(vm SchemaVM) {
	@Layout("schema", "Schema Explorer") {
		<div class="grid grid-cols-1 lg:grid-cols-4 gap-4">
			<div class="card p-3 lg:col-span-1 h-fit">
				<div class="text-xs uppercase tracking-wider text-slate-500 px-2 mb-2">Datasets</div>
				<div class="space-y-0.5 max-h-[70vh] overflow-y-auto">
					if len(vm.Datasets) == 0 {
						<p class="text-sm text-slate-500 px-2">No datasets yet.</p>
					}
					for _, d := range vm.Datasets {
						@schemaListItem(d, vm.Selected != nil && vm.Selected.Dataset.ID == d.ID)
					}
				</div>
			</div>
			<div class="lg:col-span-3">
				if vm.Selected == nil {
					@EmptyState("Select a dataset", "Choose a dataset to explore its columns, types, and statistics.")
				} else {
					<div class="card p-5">
						<div class="flex items-center justify-between mb-4">
							<div>
								<div class="flex items-center gap-2">
									<h2 class="text-base font-semibold text-white">{ vm.Selected.Dataset.Name }</h2>
									@FormatPill(vm.Selected.Dataset.Format)
								</div>
								<p class="text-sm text-slate-500">{ schemaSubtitle(vm.Selected) }</p>
							</div>
							<a href={ templ.SafeURL("/datasets/" + vm.Selected.Dataset.ID) } class="btn-ghost text-xs">Open dataset</a>
						</div>
						if vm.Selected.Schema == nil || len(vm.Selected.Schema.Columns) == 0 {
							<p class="text-sm text-slate-500">No schema inferred yet.</p>
						} else {
							@schemaTable(vm.Selected.Schema)
						}
					</div>
				}
			</div>
		</div>
	}
}

templ schemaListItem(d model.Dataset, active bool) {
	<a
		href={ templ.SafeURL("/schema?dataset_id=" + d.ID) }
		class={ "flex items-center gap-2 px-2 py-2 rounded-lg text-sm", templ.KV("bg-base-800 text-white", active), templ.KV("text-slate-300 hover:bg-base-850", !active) }
	>
		@iconTable()
		<span class="truncate flex-1">{ d.Name }</span>
		@FormatPill(d.Format)
	</a>
}
