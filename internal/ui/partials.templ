package ui

// Toast renders an ephemeral confirmation used after HTMX actions. It removes
// itself after a few seconds via a tiny inline script (no extra JS library).
templ Toast(message, tone string) {
	<div class={ "fixed bottom-6 right-6 z-50 card px-4 py-3 text-sm shadow-lg border-l-4", toastTone(tone) }>
		{ message }
		<script>
			(function(){ var el = document.currentScript.parentElement; setTimeout(function(){ el.remove(); }, 3500); })();
		</script>
	</div>
}
