package ui

// Layout is the base shell: sidebar, topbar, and content slot. Dark mode is the
// default; a vanilla-JS toggle persists the preference (no Alpine needed).
templ Layout(active string, pageTitle string) {
	<!doctype html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ pageTitle } · Apexion</title>
			<link rel="stylesheet" href="/assets/css/app.css"/>
			<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml"/>
			<script src="/assets/js/htmx.min.js" defer></script>
			<script>
				// Apply the saved theme before first paint to avoid a flash. Dark is
				// the default: only an explicit 'light' choice overrides it.
				(function () {
					try {
						if (localStorage.getItem('apexion.theme') === 'light') {
							document.documentElement.dataset.theme = 'light';
						}
					} catch (e) {}
				})();
				// Sync the toggle icons to the restored theme once the DOM is ready.
				document.addEventListener('DOMContentLoaded', function () {
					var light = document.documentElement.dataset.theme === 'light';
					document.querySelectorAll('[data-theme-icon]').forEach(function (el) {
						el.hidden = el.getAttribute('data-theme-icon') !== (light ? 'light' : 'dark');
					});
				});
			</script>
		</head>
		<body class="min-h-screen">
			<div class="flex min-h-screen">
				@sidebar(active)
				<div class="flex-1 flex flex-col min-w-0 md:pl-64">
					@topbar(pageTitle)
					<main class="flex-1 px-6 py-6 max-w-[1600px] w-full mx-auto">
						{ children... }
					</main>
					<footer class="px-6 py-4 text-xs text-slate-600 border-t border-base-800">
						Apexion · open-source data discovery · DuckDB + MinIO + templ
					</footer>
				</div>
			</div>
			<script>
				function toggleTheme() {
					const root = document.documentElement;
					const light = root.dataset.theme !== 'light';
					root.dataset.theme = light ? 'light' : 'dark';
					try { localStorage.setItem('apexion.theme', light ? 'light' : 'dark'); } catch (e) {}
					document.querySelectorAll('[data-theme-icon]').forEach(function (el) {
						el.hidden = el.getAttribute('data-theme-icon') !== (light ? 'dark' : 'light');
					});
				}
			</script>
		</body>
	</html>
}

templ sidebar(active string) {
	<aside class="fixed inset-y-0 left-0 z-30 hidden w-64 flex-col border-r border-base-800 bg-base-900 md:flex">
		<div class="flex items-center gap-2.5 px-5 h-16 border-b border-base-800">
			<div class="grid place-items-center w-9 h-9 rounded-lg bg-brand-600 text-white font-bold">A</div>
			<div>
				<div class="font-semibold text-white leading-tight">Apexion</div>
				<div class="text-[11px] text-slate-500 leading-tight">Data Discovery</div>
			</div>
		</div>
		<nav class="flex-1 overflow-y-auto p-3 space-y-1">
			@navLink("/explorer", "Explorer", active == "explorer", iconFolder())
			@navLink("/datasets", "Datasets", active == "datasets", iconInbox())
			@navLink("/catalog", "Catalog", active == "catalog", iconTable())
			@navLink("/query", "Query", active == "query", iconTerminal())
			<div class="pt-3 mt-3 border-t border-base-800"></div>
			@navLink("/settings", "Settings", active == "settings", iconGear())
		</nav>
		<div class="p-3 text-[11px] text-slate-600 border-t border-base-800">
			Apexion · Explorer
		</div>
	</aside>
}

templ navLink(href, label string, isActive bool, icon templ.Component) {
	<a
		href={ templ.SafeURL(href) }
		class={ "nav-link", templ.KV("nav-link-active", isActive) }
	>
		@icon
		<span>{ label }</span>
	</a>
}

templ topbar(pageTitle string) {
	<header class="sticky top-0 z-20 flex items-center gap-4 h-16 px-6 border-b border-base-800 bg-base-950/80 backdrop-blur">
		<h1 class="text-lg font-semibold text-white">{ pageTitle }</h1>
		<div class="flex-1"></div>
		<button onclick="toggleTheme()" class="btn-ghost" title="Toggle theme" aria-label="Toggle light/dark theme">
			<!-- Shown in dark mode (click → light). -->
			<span data-theme-icon="dark">
				@iconSun()
			</span>
			<!-- Shown in light mode (click → dark). Hidden by default (dark). -->
			<span data-theme-icon="light" hidden>
				@iconMoon()
			</span>
		</button>
	</header>
}
