package ui

import (
	"fmt"
	"github.com/apexion/apexion/internal/catalog"
	"github.com/apexion/apexion/internal/model"
)

var datasetTabs = []struct{ Key, Label string }{
	{"overview", "Overview"}, {"schema", "Schema"},
	{"files", "Files"}, {"partitions", "Partitions"}, {"preview", "Preview"},
	{"catalog", "Catalog"},
}

templ DatasetDetailPage(d *catalog.DatasetDetail, tab string, status catalog.CatalogStatus, suggested string) {
	@Layout("datasets", "Dataset") {
		<div class="flex flex-wrap items-start justify-between gap-4 mb-6">
			<div class="min-w-0">
				<div class="flex items-center gap-3">
					<h1 class="page-title truncate">{ d.Dataset.Name }</h1>
					@FormatPill(d.Dataset.Format)
				</div>
				<p class="muted mt-1 font-mono break-all">{ d.Dataset.BucketName }/{ d.Dataset.Path }</p>
				if d.Dataset.Description != "" {
					<p class="text-sm text-slate-400 mt-2 max-w-2xl">{ d.Dataset.Description }</p>
				}
			</div>
			<form hx-post="/ui/catalog" hx-target="#toast-slot" hx-swap="innerHTML" class="flex items-end gap-2 shrink-0">
				<input type="hidden" name="dataset_id" value={ d.Dataset.ID }/>
				<div>
					<label class="form-label">SQL table name</label>
					<input name="name" placeholder="auto" class="input font-mono"/>
				</div>
				<button class="btn-primary" type="submit">@iconTable() Register into Catalog</button>
			</form>
		</div>

		<div class="grid grid-cols-2 md:grid-cols-4 xl:grid-cols-6 gap-3 mb-6">
			@miniStat("Rows (est.)", humanCount(d.Dataset.RowCount))
			@miniStat("Files", fmt.Sprintf("%d", d.Dataset.FileCount))
			@miniStat("Size", humanBytes(d.Dataset.TotalSize))
			@miniStat("Columns", fmt.Sprintf("%d", columnCount(d)))
			@miniStat("Partitions", fmt.Sprintf("%d", len(d.Partitions)))
			@miniStat("Compression", string(d.Dataset.Compression))
		</div>

		<div class="flex items-center gap-1 border-b border-base-800 mb-6 overflow-x-auto">
			for _, t := range datasetTabs {
				@datasetTab(d.Dataset.ID, t.Key, t.Label, tab == t.Key)
			}
		</div>

		switch tab {
		case "schema":
			@schemaCard(d)
		case "files":
			@filesPanel(d)
		case "partitions":
			@partitionsPanel(d)
		case "preview":
			@previewPanel(d)
		case "catalog":
			@catalogPanel(d, status, suggested)
		default:
			<div class="space-y-6">
				@datasetSummaryCard(d)
				@schemaCard(d)
				@sampleCard(d)
			</div>
		}
		<div id="toast-slot"></div>
	}
}

templ datasetTab(id, key, label string, active bool) {
	<a
		href={ templ.SafeURL("/datasets/" + id + "?tab=" + key) }
		class={ "px-4 py-2.5 text-sm border-b-2 -mb-px whitespace-nowrap transition-colors", templ.KV("border-brand-500 text-white", active), templ.KV("border-transparent text-slate-400 hover:text-slate-200", !active) }
	>{ label }</a>
}

templ filesPanel(d *catalog.DatasetDetail) {
	@Card() {
		@CardHeader("Files ("+fmt.Sprintf("%d", d.Dataset.FileCount)+")", "") {
		}
		@CardBody() {
			if len(d.Objects) == 0 {
				<p class="text-sm text-slate-500">No files linked to this dataset.</p>
			} else {
				<div class="card overflow-hidden divide-y divide-base-800">
					for _, o := range d.Objects {
						<a href={ templ.SafeURL(previewURLForObject(o)) } class="flex items-center gap-3 px-4 py-2.5 hover:bg-base-850/60">
							<span class="text-slate-500">@iconFile()</span>
							<span class="text-sm text-slate-200 flex-1 truncate font-mono">{ o.Key }</span>
							@FormatPill(o.Format)
							<span class="text-xs text-slate-500 w-20 text-right">{ humanBytes(o.Size) }</span>
							<span class="text-xs text-slate-600 w-24 text-right hidden sm:block">{ timeAgo(o.Modified) }</span>
						</a>
					}
				</div>
				if int64(len(d.Objects)) < d.Dataset.FileCount {
					<p class="text-xs text-slate-500 mt-2">Showing first { fmt.Sprintf("%d", len(d.Objects)) } of { fmt.Sprintf("%d", d.Dataset.FileCount) } files.</p>
				}
			}
		}
	}
}

// catalogPanel shows a dataset's catalog status and a register form. A dataset
// may back several tables, so registering is always available.
templ catalogPanel(d *catalog.DatasetDetail, status catalog.CatalogStatus, suggested string) {
	<div class="space-y-6">
		@Card() {
			@CardHeader("Catalog status", "") {
				if status.Registered {
					<span class="badge bg-accent-emerald/15 text-accent-emerald">Registered</span>
				} else {
					<span class="badge bg-base-700 text-slate-400">Not registered</span>
				}
			}
			@CardBody() {
				if len(status.Entries) == 0 {
					<p class="text-sm text-slate-500">This dataset is not exposed as a SQL table yet.</p>
				} else {
					<div class="card overflow-hidden divide-y divide-base-800">
						for _, e := range status.Entries {
							<div class="flex items-center gap-3 px-4 py-2.5">
								@iconTable()
								<a href={ templ.SafeURL("/query?table=" + e.Name) } class="text-sm font-mono text-slate-100 flex-1 break-all hover:text-brand-300">{ e.Name }</a>
								<span class="text-xs text-slate-500 shrink-0">{ e.SchemaStrategy }</span>
								<a class="btn-ghost text-xs shrink-0" href={ templ.SafeURL("/query?table=" + e.Name) }>@iconTerminal() Query</a>
							</div>
						}
					</div>
				}
			}
		}
		@Card() {
			@CardHeader("Register as SQL table", "") {
			}
			@CardBody() {
				<form hx-post="/ui/catalog" hx-target="#toast-slot" hx-swap="innerHTML" class="flex flex-wrap items-end gap-3">
					<input type="hidden" name="dataset_id" value={ d.Dataset.ID }/>
					<div>
						<label class="form-label">Table name</label>
						<input name="name" value={ suggested } pattern="[A-Za-z_][A-Za-z0-9_]*" class="input font-mono"/>
					</div>
					<button class="btn-primary" type="submit">@iconTable() Register</button>
				</form>
				<p class="text-[11px] text-slate-600 mt-2">Registering creates a DuckDB view over the files — no data is copied. A dataset can back multiple tables (different names/globs).</p>
			}
		}
	</div>
}

templ partitionsPanel(d *catalog.DatasetDetail) {
	if len(d.Partitions) == 0 {
		@EmptyState("No partitions", "This dataset is not partitioned.")
	} else {
		@partitionsCard(d)
	}
}

templ previewPanel(d *catalog.DatasetDetail) {
	@Card() {
		<div class="card-header">
			<h2 class="section-title">DuckDB preview</h2>
			<p class="muted mt-1 font-mono break-all">SELECT * FROM read_{ string(d.Dataset.Format) }('s3://{ d.Dataset.BucketName }/{ d.Dataset.Path }/…')</p>
		</div>
		@CardBody() {
			<div hx-get={ "/ui/datasets/" + d.Dataset.ID + "/preview" } hx-trigger="load" hx-swap="innerHTML">
				<div class="p-8 text-center text-sm text-slate-500">Querying object storage…</div>
			</div>
		}
	}
}

// datasetSummaryCard is the top-of-overview summary.
templ datasetSummaryCard(d *catalog.DatasetDetail) {
	@Card() {
		@CardHeader("Summary", "") {
		}
		@CardBody() {
			<dl class="grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-3 text-sm">
				@summaryItem("Storage provider", "Object storage (S3)")
				@summaryItem("Catalog provider", "Embedded DuckDB")
				@summaryItem("Format", string(d.Dataset.Format))
				@summaryItem("Compression", string(d.Dataset.Compression))
				@summaryItem("Estimated rows", humanCount(d.Dataset.RowCount))
				@summaryItem("Columns", fmt.Sprintf("%d", columnCount(d)))
				@summaryItem("Files", fmt.Sprintf("%d", d.Dataset.FileCount))
				@summaryItem("Total size", humanBytes(d.Dataset.TotalSize))
				@summaryItem("Partition keys", partitionKeysLabel(d))
				@summaryItem("Partition depth", fmt.Sprintf("%d", d.Dataset.PartitionDepth))
				@summaryItem("Discovery", discoveryLabel(d.Dataset.DiscoveryStrategy))
				@summaryItem("Dataset root", datasetRootLabel(d))
				@summaryItem("Schema version", schemaVersionLabel(d))
			</dl>
		}
	}
}

templ summaryItem(label, value string) {
	<div class="min-w-0">
		<dt class="text-[11px] uppercase tracking-wider text-slate-500">{ label }</dt>
		<dd class="text-slate-200 truncate mt-0.5">{ value }</dd>
	</div>
}

templ miniStat(label, value string) {
	<div class="card p-3">
		<div class="text-[11px] uppercase tracking-wider text-slate-500">{ label }</div>
		<div class="text-lg font-semibold text-white mt-0.5 truncate">{ value }</div>
	</div>
}

templ schemaCard(d *catalog.DatasetDetail) {
	@Card() {
		@CardHeader("Schema", schemaSubtitle(d)) {
		}
		@CardBody() {
			if d.Schema == nil || len(d.Schema.Columns) == 0 {
				<p class="text-sm text-slate-500">No schema inferred yet.</p>
			} else {
				@schemaTable(d.Schema)
			}
		}
	}
}

templ schemaTable(schema *model.Schema) {
	<div class="overflow-x-auto">
		<table class="w-full">
			<thead>
				<tr class="border-b border-base-800">
					<th class="th">Column</th>
					<th class="th">Type</th>
					<th class="th">Null</th>
					<th class="th">Distinct</th>
					<th class="th">Complete</th>
					<th class="th">Sample</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-base-800">
				for _, c := range schema.Columns {
					<tr class="hover:bg-base-850/50">
						<td class="table-cell font-medium text-slate-200">
							{ c.Name }
							if c.IsPartition {
								<span class="badge bg-accent-amber/15 text-accent-amber ml-1">part</span>
							}
						</td>
						<td class="table-cell">@TypePill(c.DataType)</td>
						<td class="table-cell text-slate-400">{ yesNo(c.Nullable) }</td>
						<td class="table-cell text-slate-300">{ statDistinct(c) }</td>
						<td class="table-cell text-slate-300">{ statComplete(c) }</td>
						<td class="table-cell text-slate-500 font-mono text-xs break-all">{ statSamples(c) }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ sampleCard(d *catalog.DatasetDetail) {
	@Card() {
		@CardHeader("Data sample", "") {
		}
		@CardBody() {
			if len(d.SampleRows) == 0 {
				<p class="text-sm text-slate-500">No sample captured (table formats and empty files have no inline sample).</p>
			} else {
				<div class="overflow-x-auto rounded-lg border border-base-800">
					<table class="w-full">
						<thead>
							<tr class="border-b border-base-800 bg-base-850">
								for _, col := range d.SampleColumns {
									<th class="th whitespace-nowrap">{ col }</th>
								}
							</tr>
						</thead>
						<tbody class="divide-y divide-base-800">
							for _, row := range sampleHead(d.SampleRows, 12) {
								<tr class="hover:bg-base-850/50">
									for _, col := range d.SampleColumns {
										<td class="table-cell font-mono text-xs text-slate-300 whitespace-nowrap max-w-xs truncate">{ truncate(row[col], 40) }</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}

templ partitionsCard(d *catalog.DatasetDetail) {
	@Card() {
		@CardHeader("Partitions ("+fmt.Sprintf("%d", len(d.Partitions))+")", "") {
		}
		@CardBody() {
			<div class="overflow-x-auto">
				<table class="w-full">
					<thead>
						<tr class="border-b border-base-800">
							<th class="th">Partition</th>
							<th class="th">Files</th>
							<th class="th">Size</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-base-800">
						for _, p := range partitionHead(d.Partitions, 20) {
							<tr class="hover:bg-base-850/50">
								<td class="table-cell font-mono text-xs text-slate-300 break-all">{ p.Path }</td>
								<td class="table-cell text-slate-400">{ fmt.Sprintf("%d", p.FileCount) }</td>
								<td class="table-cell text-slate-400">{ humanBytes(p.Size) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}
