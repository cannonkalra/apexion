package ui

import (
	"strconv"

	"github.com/apexion/apexion/internal/duckdb"
	"github.com/apexion/apexion/internal/model"
)

// CatalogPage lists the registered logical SQL tables. Each maps to a DuckDB
// view that reads directly from object storage.
templ CatalogPage(vm CatalogVM) {
	@Layout("catalog", "Catalog") {
		@PageHeader("", "SQL tables saved from selected files or discovered folders. Each reads its files directly from storage — no data is copied.") {
			<a class="btn-ghost" href="/explorer">@iconFolder() Select files</a>
		}
		@lakeStatus(vm.Lake)
		if len(vm.Entries) == 0 {
			@EmptyState("No tables yet", "Select files in the Explorer and save them as a table, or save a discovered folder.")
		} else {
			<div class="card overflow-hidden">
				<div class="overflow-x-auto">
					<table class="w-full">
						<thead>
							<tr class="border-b border-base-800 bg-base-850">
								<th class="th">Table</th>
								<th class="th">Format</th>
								<th class="th">Partition columns</th>
								<th class="th">Refresh</th>
								<th class="th">Last refresh</th>
								<th class="th text-right">Actions</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-base-800">
							for _, e := range vm.Entries {
								@catalogRow(e)
							}
						</tbody>
					</table>
				</div>
			</div>
		}
		<div id="toast-slot"></div>
	}
}

templ catalogRow(e model.CatalogEntry) {
	<tr id={ "catalog-" + e.ID } class="hover:bg-base-850/50">
		<td class="table-cell">
			<div class="font-medium text-white font-mono break-all">{ e.Name }</div>
			if e.SelectSQL != "" {
				<div class="text-xs text-slate-500">{ selectionSourceLabel(e.SelectSQL) }</div>
			} else {
				<a href={ templ.SafeURL("/datasets/" + e.DatasetID) } class="block text-xs text-slate-500 hover:text-slate-300 font-mono break-all max-w-md" title="Discovered folder">{ e.URI }</a>
			}
		</td>
		<td class="table-cell">@FormatPill(e.Format)</td>
		<td class="table-cell text-xs text-slate-400 font-mono">
			if len(e.PartitionCols) == 0 {
				<span class="text-slate-600">—</span>
			} else {
				{ join(e.PartitionCols, ", ") }
			}
		</td>
		<td class="table-cell text-slate-400">{ e.RefreshMode }</td>
		<td class="table-cell text-slate-500 text-xs">{ timeAgoPtr(e.LastRefreshAt) }</td>
		<td class="table-cell">
			<div class="flex items-center justify-end gap-2">
				<a class="btn-ghost text-xs" href={ templ.SafeURL("/query?table=" + e.Name) }>@iconTerminal() Query</a>
				<button
					class="btn-ghost text-xs"
					hx-post={ "/ui/catalog/" + e.ID + "/refresh" }
					hx-target="#toast-slot"
					hx-swap="innerHTML"
				>@iconRefresh() Refresh</button>
				<button
					class="btn-ghost text-xs text-accent-rose"
					hx-delete={ "/ui/catalog/" + e.ID }
					hx-target={ "#catalog-" + e.ID }
					hx-swap="outerHTML"
					hx-confirm={ "Drop table " + e.Name + "?" }
				>@iconTrash()</button>
			</div>
		</td>
	</tr>
}

// lakeStatus says where catalog tables are stored: the attached DuckLake (with
// its latest snapshot and how to attach it from any DuckDB client), or — when
// the lake failed to attach — that tables are in-memory only.
templ lakeStatus(l duckdb.LakeStatus) {
	if l.Attached {
		<div class="banner-info mb-6">
			Stored in DuckLake <span class="font-mono">{ l.Metadata }</span>
			if l.SnapshotID > 0 {
				· snapshot #{ strconv.FormatInt(l.SnapshotID, 10) }, { timeAgo(l.SnapshotTime) }
			}
			<div class="mt-1 text-xs text-slate-400">
				Query it from any DuckDB client: <span class="font-mono select-all">{ "ATTACH 'ducklake:" + l.Metadata + "' AS lake (READ_ONLY);" }</span>
			</div>
		</div>
	} else if l.Err != "" {
		<div class="mb-6">
			@ErrorBanner("DuckLake unavailable (" + l.Err + "). Tables are kept in memory and rebuilt on restart.")
		</div>
	}
}
